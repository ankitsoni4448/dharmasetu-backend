{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DharmaSetu Mantra V2 Manifest",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 2 },
    "generatedAt": { "type": "string" },
    "source": { "type": ["string", "object"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "canonicalName", "contentType", "sanskritText", "verificationStatus"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "schemaVersion": { "type": "integer", "minimum": 2 },
          "contentVersion": { "type": "string" },
          "canonicalName": { "type": "string", "minLength": 1 },
          "names": { "type": "object" },
          "contentType": { "enum": ["MANTRA", "NAMA_JAPA", "VEDIC_MANTRA", "SHLOKA", "PRAYER", "STOTRA"] },
          "deityIds": { "type": "array", "items": { "type": "string" } },
          "categoryIds": { "type": "array", "items": { "type": "string" } },
          "purposeIds": { "type": "array", "items": { "type": "string" } },
          "sanskritText": { "type": "string", "minLength": 1 },
          "transliterationIast": { "type": ["string", "null"] },
          "transliterationSimple": { "type": ["string", "null"] },
          "wordSegments": { "type": "array" },
          "meanings": { "type": "object" },
          "sourceReferences": { "type": "array", "items": { "type": "object" } },
          "tradition": { "type": ["string", "null"] },
          "sampradaya": { "type": ["string", "null"] },
          "practiceLevel": { "enum": ["GENERAL_DEVOTIONAL", "TRADITION_SPECIFIC", "INITIATION_GUIDANCE"] },
          "instructionsScope": { "type": ["string", "null"] },
          "requiresInitiation": { "type": ["boolean", "null"] },
          "restrictionNote": { "type": ["string", "null"] },
          "verificationStatus": { "enum": ["VERIFIED", "REVIEW_REQUIRED", "RESTRICTED"] },
          "reviewedBy": { "type": ["string", "null"] },
          "reviewedAt": { "type": ["string", "null"] },
          "practice": { "type": ["object", "null"] },
          "audio": { "type": ["object", "null"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "searchText": { "type": "string" },
          "isActive": { "type": "boolean" }
        },
        "allOf": [{
          "if": { "properties": { "verificationStatus": { "const": "VERIFIED" } }, "required": ["verificationStatus"] },
          "then": {
            "required": ["sourceReferences", "reviewedBy", "reviewedAt"],
            "properties": { "sourceReferences": { "minItems": 1 }, "reviewedBy": { "type": "string", "minLength": 1 }, "reviewedAt": { "type": "string", "minLength": 1 } }
          }
        }]
      }
    }
  }
}
